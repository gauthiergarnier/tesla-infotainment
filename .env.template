# Add your Google Maps API key here
REACT_APP_GOOGLE_MAPS_API_KEY=YOUR_API_KEY_HERE

# This is the map ID for the map I created to resemble Tesla UI's Map. 
# Feel free to change it to your own map ID.
REACT_APP_GOOGLE_MAPS_MAP_ID=2d1b7cd2cf277f7

# Add your GitHub Pages URL here
PUBLIC_URL=

# --- codriver demo mode (ALL-25) -------------------------------------------
# The Browser app's web view opens on codriver's demo mode. Which codriver it
# frames follows this build: `staging` (default for `npm start`) or
# `production` (default for a production build).
REACT_APP_CODRIVER_ENV=staging

# Escape hatch: point the web view at any URL, used verbatim. For working on
# both repos at once, e.g. REACT_APP_CODRIVER_DEMO_URL=http://localhost:4399/?demo=1
# REACT_APP_CODRIVER_DEMO_URL=

# NOTE: codriver refuses to be framed by default (X-Frame-Options: DENY). The
# codriver server must set DEMO_FRAME_ANCESTORS to an allowlist containing this
# app's origin, or the web view renders blank. See codriver-app's CLAUDE.md.
